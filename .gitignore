# ---------------------------------------------------------------------------
# WinClip — repo público: nada de secretos, datos del usuario ni media.
# ---------------------------------------------------------------------------

# Entornos y secretos (nunca commitear; .env.example sí se versiona)
.env
.env.*
!**/.env.example
*.pem
*.key
client_secret*.json
**/tokens/
**/credentials*.json
**/cookies*.json
**/*.cookies.txt

# Datos generados por la app (media, base de datos, caché, perfiles)
storage/
storage-*/
**/storage/
**/user-data-dir*/
**/playwright-profile*/
**/.playwright/
**/playwright/.auth/

# Multimedia (fuentes, clips, audio, subtítulos generados)
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ass
*.srt
*.vtt
!assets/subtitle-presets/*.json
!apps/api/tests/fixtures/golden/*.ass

# Test results and reports
playwright-report/
test-results/

# Node / pnpm
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.python-version.lock
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
.eggs/
site/

# Logs
*.log
logs/

# Herramientas / sistema
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Locales de macOS y volcados temporales
*.local
tmp/
temp/
.cache/
