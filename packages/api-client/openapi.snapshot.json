{"openapi": "3.1.0", "info": {"title": "WinClip", "description": "API local de WinClip (clipping, jobs y publicaci\u00f3n).", "version": "0.1.0"}, "paths": {"/api/health": {"get": {"tags": ["health"], "summary": "Health", "operationId": "getHealth", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthOut"}}}}}}}, "/api/projects": {"get": {"tags": ["projects"], "summary": "List Projects", "description": "Proyectos del m\u00e1s reciente al m\u00e1s antiguo con resumen de clips y trabajos.", "operationId": "listProjects", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/ProjectOut"}, "type": "array", "title": "Response Listprojects"}}}}}}, "post": {"tags": ["projects"], "summary": "Create Project", "description": "Crea un proyecto desde una URL (JSON) o un archivo (multipart streaming).", "operationId": "createProject", "requestBody": {"content": {"application/json": {"schema": {"properties": {"source_type": {"type": "string", "enum": ["url"]}, "source_url": {"type": "string", "format": "uri"}, "title": {"type": "string", "maxLength": 500}, "requested_clips": {"oneOf": [{"type": "integer", "minimum": 1.0}, {"enum": ["max"]}]}, "language": {"type": "string", "enum": ["auto", "es", "en"]}, "campaign_id": {"type": "string"}, "subtitle_preset": {"type": "string"}, "reframe_mode": {"type": "string", "enum": ["face", "center", "blur", "passthrough"]}}, "type": "object", "required": ["source_url"]}}, "multipart/form-data": {"schema": {"properties": {"file": {"type": "string", "format": "binary"}, "source_type": {"type": "string", "enum": ["file", "url"]}, "source_url": {"type": "string", "format": "uri"}, "title": {"type": "string", "maxLength": 500}, "requested_clips": {"oneOf": [{"type": "integer", "minimum": 1.0}, {"enum": ["max"]}]}, "language": {"type": "string", "enum": ["auto", "es", "en"]}, "campaign_id": {"type": "string"}, "subtitle_preset": {"type": "string"}, "reframe_mode": {"type": "string", "enum": ["face", "center", "blur", "passthrough"]}}, "type": "object"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectCreated"}}}}}}}, "/api/projects/{project_id}": {"get": {"tags": ["projects"], "summary": "Get Project", "description": "Detalle de un proyecto con sus clips y trabajos.", "operationId": "getProject", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectOut"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["projects"], "summary": "Delete Project", "description": "Cancela trabajos activos y borra el proyecto, sus filas y su carpeta.", "operationId": "deleteProject", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/projects/{project_id}/clips": {"get": {"tags": ["projects"], "summary": "List Project Clips", "description": "Clips del proyecto ordenados por `score` descendente.", "operationId": "listProjectClips", "parameters": [{"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Project Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ClipOut"}, "title": "Respo