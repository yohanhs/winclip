# ---------------------------------------------------------------------------
# WinClip — configuración de ejemplo. Copia a `.env` (ignorado por git) y ajusta.
# Ninguna clave es obligatoria: la API arranca sin claves de LLM.
# ---------------------------------------------------------------------------

# Marca visible y puertos de desarrollo
APP_NAME=WinClip
API_PORT=8000
WEB_PORT=3000

# Raíz de datos (media, base de datos, caché). Relativa a la raíz del repo o absoluta.
STORAGE_DIR=./storage
# Ejemplo con volumen externo (máquina del autor):
# STORAGE_DIR=/Volumes/yohan/Proyectos/winclip/storage

# Si no se define, se deriva como sqlite:///{STORAGE_DIR}/winclip.db
# DATABASE_URL=sqlite:///./storage/winclip.db

# Herramientas locales. ffmpeg-full es keg-only y trae libass; NUNCA usar el ffmpeg del PATH.
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
YTDLP_BIN=yt-dlp

# Transcripción (modelo en caché de Hugging Face)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# LLM gratuitos con router y fallback. Deja vacío lo que no uses.
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER_ORDER=gemini,nvidia,openrouter,groq,ollama
OLLAMA_HOST=http://localhost:11434

# Modelos gratuitos por proveedor y política del router (configurables sin tocar código)
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_SCORE_THRESHOLD=60
LLM_SINGLE_PASS_MAX_CHARS=45000

# OAuth y publicación (rutas y claves fuera del repo)
GOOGLE_CLIENT_SECRET_FILE=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Opcional: clave Fernet para cifrar tokens. Si falta se usa el Keychain de macOS.
WINCLIP_SECRET_KEY=

# Fuentes locales no redistribuibles (p. ej. Gotham). Las OFL viven en assets/fonts.
USER_FONTS_DIR=~/Library/Fonts
